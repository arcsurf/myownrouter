#!/bin/sh /etc/rc.common
# Tareas de arranque de MyOwnRouter:
# - detiene servicios opcionales que estén deshabilitados (en el primer arranque
#   procd ya armó la lista de inicio antes de que uci-defaults los deshabilite);
# - configura la WiFi la primera vez que aparece la radio (el MT7921 puede tardar
#   en cargar el firmware).
START=99
USE_PROCD=1

OPTIONAL="tailscale adguardhome tor zerotier openvpn ksmbd miniupnpd mwan3 sqm ttyd"

start_service() {
	for s in $OPTIONAL; do
		[ -x /etc/init.d/$s ] || continue
		/etc/init.d/$s enabled || /etc/init.d/$s stop >/dev/null 2>&1
	done
	[ "$(uci -q get myownrouter.state.wifi_done)" = 1 ] && return 0
	procd_open_instance
	procd_set_param command /bin/sh /usr/libexec/myownrouter/wifi-firstboot.sh
	procd_close_instance
}
