#!/bin/sh /etc/rc.common
# Configura la WiFi la primera vez que aparece la radio (el MT7921 puede tardar en cargar firmware).
START=99
USE_PROCD=1

start_service() {
	[ -f /etc/myownrouter/.wifi-done ] && return 0
	procd_open_instance
	procd_set_param command /bin/sh /usr/libexec/myownrouter/wifi-firstboot.sh
	procd_close_instance
}
