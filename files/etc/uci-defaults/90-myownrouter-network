#!/bin/sh
# MyOwnRouter: configuración de primer arranque.
# - WAN  = primera NIC virtio (bridge del hipervisor); si no hay virtio, eth0.
# - LAN  = el resto de NICs (puertos físicos pasados por PCI) + WiFi.
# - Guest = red de invitados aislada.

# Solo la primera vez: la marca vive en UCI para sobrevivir a un sysupgrade.
[ "$(uci -q get myownrouter.state.network_done)" = 1 ] && exit 0
[ -f /etc/myownrouter/.network-done ] && exit 0

LAN_IP=192.168.20.1
GUEST_IP=192.168.21.1

WAN=""
LAN=""
for d in /sys/class/net/eth*; do
	[ -e "$d" ] || continue
	n=${d##*/}
	drv=$(basename "$(readlink -f "$d/device/driver")" 2>/dev/null)
	case "$drv" in
		virtio*) if [ -z "$WAN" ]; then WAN=$n; else LAN="$LAN $n"; fi ;;
		*) LAN="$LAN $n" ;;
	esac
done
if [ -z "$WAN" ]; then
	WAN=eth0
	LAN=$(echo "$LAN" | sed 's/\beth0\b//')
fi

# ---------- network ----------
uci -q batch <<EOF
delete network.wan
delete network.wan6
delete network.lan
set network.globals.packet_steering='1'
EOF

# borrar devices bridge previos
for s in $(uci -q show network | sed -n 's/^network\.\([^.]*\)=device$/\1/p'); do
	uci -q delete network.$s
done

uci -q batch <<EOF
set network.br_lan=device
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
set network.br_lan.bridge_empty='1'
set network.lan=interface
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='$LAN_IP'
set network.lan.netmask='255.255.255.0'
set network.lan.ip6assign='60'
set network.wan=interface
set network.wan.device='$WAN'
set network.wan.proto='dhcp'
set network.wan.hostname='myownrouter'
set network.wan6=interface
set network.wan6.device='$WAN'
set network.wan6.proto='dhcpv6'
set network.br_guest=device
set network.br_guest.name='br-guest'
set network.br_guest.type='bridge'
set network.br_guest.bridge_empty='1'
set network.guest=interface
set network.guest.device='br-guest'
set network.guest.proto='static'
set network.guest.ipaddr='$GUEST_IP'
set network.guest.netmask='255.255.255.0'
EOF
for p in $LAN; do uci add_list network.br_lan.ports="$p"; done
uci commit network

# ---------- dhcp ----------
uci -q batch <<EOF
set dhcp.lan=dhcp
set dhcp.lan.interface='lan'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
set dhcp.guest=dhcp
set dhcp.guest.interface='guest'
set dhcp.guest.start='100'
set dhcp.guest.limit='150'
set dhcp.guest.leasetime='2h'
set dhcp.@dnsmasq[0].domain='lan'
set dhcp.@dnsmasq[0].local='/lan/'
commit dhcp
EOF

# ---------- firewall ----------
# zona guest + acceso de gestión desde redes privadas aguas arriba (WAN = LAN de casa)
uci -q batch <<EOF
set firewall.guest=zone
set firewall.guest.name='guest'
add_list firewall.guest.network='guest'
set firewall.guest.input='REJECT'
set firewall.guest.output='ACCEPT'
set firewall.guest.forward='REJECT'
set firewall.guest_wan=forwarding
set firewall.guest_wan.src='guest'
set firewall.guest_wan.dest='wan'
set firewall.guest_dns=rule
set firewall.guest_dns.name='Guest-DHCP-DNS'
set firewall.guest_dns.src='guest'
set firewall.guest_dns.proto='tcp udp'
set firewall.guest_dns.dest_port='53 67 68'
set firewall.guest_dns.target='ACCEPT'
set firewall.wan_mgmt=rule
set firewall.wan_mgmt.name='Gestion-desde-WAN-privada'
set firewall.wan_mgmt.src='wan'
set firewall.wan_mgmt.proto='tcp'
set firewall.wan_mgmt.dest_port='22 80 443'
add_list firewall.wan_mgmt.src_ip='10.0.0.0/8'
add_list firewall.wan_mgmt.src_ip='172.16.0.0/12'
add_list firewall.wan_mgmt.src_ip='192.168.0.0/16'
set firewall.wan_mgmt.target='ACCEPT'
set firewall.@defaults[0].flow_offloading='1'
commit firewall
EOF

# ---------- sistema ----------
uci -q batch <<EOF
set system.@system[0].hostname='MyOwnRouter'
set system.@system[0].zonename='America/Argentina/Buenos Aires'
set system.@system[0].timezone='<-03>3'
commit system
EOF

uci -q set myownrouter.state=state
uci -q set myownrouter.state.network_done=1
uci -q commit myownrouter
exit 0
