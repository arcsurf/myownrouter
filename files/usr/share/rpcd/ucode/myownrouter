// MyOwnRouter backend: ubus object "myownrouter" (loaded by rpcd-mod-ucode).
// Simple settings are edited by the web UI through the standard "uci" ubus
// object; this plugin implements the composite operations.
// SPDX-License-Identifier: GPL-2.0-only

'use strict';

import { readfile, writefile, popen, access, unlink, stat, glob, mkdir, lsdir } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';
import zoneinfo from 'luci.zoneinfo';

const STATE_DIR = '/etc/myownrouter';
const RUN_DIR = '/tmp/myownrouter';
const UPLOAD = '/tmp/myownrouter-upload.bin';

function q(s) {
	return "'" + replace(`${s ?? ''}`, "'", "'\\''") + "'";
}

function sh(cmd) {
	let p = popen(cmd + ' 2>/dev/null');
	if (!p) return '';
	let out = p.read('all') ?? '';
	p.close();
	return out;
}

// Run something detached so the RPC answers before services restart.
function bg(cmd) {
	system(`( sleep 1; ${cmd} ) >/dev/null 2>&1 </dev/null &`);
}

function ok(extra) {
	let r = { ok: true };
	for (let k, v in extra) r[k] = v;
	return r;
}

function fail(msg) {
	return { ok: false, error: msg };
}

function valid_mac(m) {
	return match(m ?? '', /^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$/) != null;
}

function valid_ip4(ip) {
	let m = match(ip ?? '', /^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)$/);
	if (!m) return false;
	for (let i = 1; i <= 4; i++) if (+m[i] > 255) return false;
	return true;
}

function valid_name(n) {
	return match(n ?? '', /^[A-Za-z0-9_]{1,15}$/) != null;
}

function ubus_call(obj, method, args) {
	let ub = connect();
	if (!ub) return null;
	let r = ub.call(obj, method, args ?? {});
	ub.disconnect();
	return r;
}

function read_int(path) {
	let s = readfile(path);
	return s ? +trim(s) : 0;
}

function password_set() {
	let sh_ = readfile('/etc/shadow') ?? '';
	let m = match(sh_, /(^|\n)root:([^:]*):/);
	return m != null && m[2] != '' && m[2] != '*' && m[2] != '!';
}

function radio_name(u) {
	let r = null;
	u.foreach('wireless', 'wifi-device', s => { if (!r) r = s['.name']; });
	return r;
}

function ap_ifname() {
	let st = ubus_call('network.wireless', 'status') ?? {};
	for (let rn, rd in st)
		for (let i in rd.interfaces ?? [])
			if (i.section == 'main' && i.ifname) return i.ifname;
	return null;
}

function sta_ifname() {
	let st = ubus_call('network.wireless', 'status') ?? {};
	for (let rn, rd in st)
		for (let i in rd.interfaces ?? [])
			if (i.section == 'wwan' && i.ifname) return i.ifname;
	return null;
}

function iface_status(name) {
	let s = ubus_call(`network.interface.${name}`, 'status');
	if (!s) return null;
	let a = s['ipv4-address']?.[0];
	let gw = null;
	for (let r in s.route ?? []) if (r.target == '0.0.0.0') gw = r.nexthop;
	let dev = s.l3_device ?? s.device;
	return {
		up: s.up, proto: s.proto, uptime: s.uptime ?? 0, device: dev,
		ipaddr: a?.address, mask: a?.mask, gateway: gw,
		dns: s['dns-server'] ?? [],
		ip6: map(s['ipv6-address'] ?? [], x => x.address),
		rx_bytes: dev ? read_int(`/sys/class/net/${dev}/statistics/rx_bytes`) : 0,
		tx_bytes: dev ? read_int(`/sys/class/net/${dev}/statistics/tx_bytes`) : 0,
		mac: dev ? trim(readfile(`/sys/class/net/${dev}/address`) ?? '') : null,
	};
}

function leases() {
	let res = {};
	for (let l in split(readfile('/tmp/dhcp.leases') ?? '', '\n')) {
		let f = split(l, ' ');
		if (length(f) < 4) continue;
		res[lc(f[1])] = { expires: +f[0], mac: lc(f[1]), ip: f[2], hostname: f[3] == '*' ? null : f[3] };
	}
	return res;
}

function neighbors() {
	let res = {};
	for (let l in split(sh('ip -4 neigh show'), '\n')) {
		let m = match(l, /^([0-9.]+) dev (\S+) lladdr ([0-9a-f:]+) (.*)$/);
		if (!m) continue;
		res[m[3]] = { ip: m[1], dev: m[2], state: trim(m[4]) };
	}
	return res;
}

// NOTE: never call the "iwinfo", "uci", "file" or "session" ubus objects from
// here: they are served by rpcd itself and the call would deadlock.
function wifi_assoc() {
	let res = {};
	for (let f in glob('/sys/class/net/phy*-ap*')) {
		let ifn = replace(f, /.*\//, '');
		if (match(ifn, /-guest$/)) continue;
		let cur = null;
		for (let l in split(sh(`iw dev ${ifn} station dump`), '\n')) {
			let m = match(l, /^Station ([0-9a-f:]+) /);
			if (m) { cur = { ifname: ifn }; res[m[1]] = cur; continue; }
			if (!cur) continue;
			let kv = match(l, /^\s+([^:]+):\s+(.*)$/);
			if (!kv) continue;
			if (kv[1] == 'signal') cur.signal = +match(kv[2], /-?[0-9]+/)[0];
			else if (kv[1] == 'tx bitrate') cur.tx_rate = +(match(kv[2], /[0-9.]+/)?.[0] ?? 0);
			else if (kv[1] == 'rx bitrate') cur.rx_rate = +(match(kv[2], /[0-9.]+/)?.[0] ?? 0);
			else if (kv[1] == 'connected time') cur.connected = +match(kv[2], /[0-9]+/)[0];
			else if (kv[1] == 'vlan') cur.vlan = +kv[2];
		}
		let r = ubus_call(`hostapd.${ifn}`, 'get_clients');
		for (let mac, c in r?.clients ?? {})
			if (res[lc(mac)] && (c.vlan_id ?? c.vlan)) res[lc(mac)].vlan = c.vlan_id ?? c.vlan;
	}
	return res;
}

function iwinfo_freqlist(ifn) {
	let res = { '2g': [], '5g': [] };
	for (let l in split(sh(`iwinfo ${ifn} freqlist`), '\n')) {
		let m = match(l, /([0-9.]+) GHz \(Band: [^,]+, Channel ([0-9]+)\)(.*)$/);
		if (!m || index(m[3], 'restricted') >= 0) continue;
		let mhz = +m[1] * 1000;
		if (mhz < 3000) push(res['2g'], +m[2]);
		else if (mhz < 5900) push(res['5g'], +m[2]);
	}
	return res;
}

function iwinfo_info(ifn) {
	let t = sh(`iwinfo ${ifn} info`);
	let ch = match(t, /Channel: ([0-9]+) \(([0-9.]+) GHz\)/);
	return {
		channel: ch ? +ch[1] : null, frequency: ch ? +ch[2] : null,
		htmode: match(t, /HT Mode: (\S+)/)?.[1], hwmodes: match(t, /HW Mode\(s\): (\S+)/)?.[1],
	};
}

function iwinfo_scan(ifn) {
	let res = [], cur = null;
	for (let l in split(sh(`iwinfo ${ifn} scan`), '\n')) {
		let m = match(l, /^Cell [0-9]+ - Address: ([0-9A-Fa-f:]+)/);
		if (m) { cur = { bssid: lc(m[1]) }; push(res, cur); continue; }
		if (!cur) continue;
		if ((m = match(l, /ESSID: "(.*)"$/))) cur.ssid = m[1];
		else if ((m = match(l, /Band: ([0-9.]+) GHz\s+Channel: ([0-9]+)/))) { cur.band = +m[1] < 3 ? '2g' : (+m[1] < 5.9 ? '5g' : '6g'); cur.channel = +m[2]; }
		else if ((m = match(l, /Signal: (-?[0-9]+) dBm\s+Quality: ([0-9]+)\/([0-9]+)/))) { cur.signal = +m[1]; cur.quality = +m[2]; cur.quality_max = +m[3]; }
		else if ((m = match(l, /Encryption: (.*)$/))) {
			let e = m[1];
			cur.encryption = e == 'none' ? 'none'
				: (index(e, 'SAE') >= 0 && index(e, 'PSK') >= 0) ? 'sae-mixed'
				: index(e, 'SAE') >= 0 ? 'sae'
				: index(e, 'PSK') >= 0 ? 'psk2' : 'psk2';
		}
	}
	return filter(res, x => x.ssid);
}

function traffic() {
	let res = {};
	let j = json(sh('nlbw -c json -g mac') || '{}');
	let cols = j?.columns ?? [];
	let im = index(cols, 'mac'), irx = index(cols, 'rx_bytes'), itx = index(cols, 'tx_bytes');
	if (im < 0) return res;
	for (let row in j.data ?? [])
		res[lc(row[im])] = { rx: row[irx], tx: row[itx] };
	return res;
}

function blocked_macs(u) {
	let r = u.get('firewall', 'mor_block', 'src_mac');
	return type(r) == 'array' ? map(r, lc) : [];
}

function set_blocked(u, mac, on) {
	let list = filter(blocked_macs(u), m => m != mac);
	if (on) push(list, mac);
	if (length(list)) {
		u.set('firewall', 'mor_block', 'rule');
		u.set('firewall', 'mor_block', 'name', 'MyOwnRouter-bloqueados');
		u.set('firewall', 'mor_block', 'src', '*');
		u.set('firewall', 'mor_block', 'dest', 'wan');
		u.set('firewall', 'mor_block', 'src_mac', list);
		u.set('firewall', 'mor_block', 'target', 'REJECT');
	} else {
		u.delete('firewall', 'mor_block');
	}
	u.save('firewall');
	u.commit('firewall');
}

function client_meta(u) {
	let res = {};
	u.foreach('myownrouter', 'client', s => {
		if (s.mac) res[lc(s.mac)] = { name: s.name, section: s['.name'] };
	});
	u.foreach('dhcp', 'host', s => {
		let macs = type(s.mac) == 'array' ? s.mac : split(s.mac ?? '', ' ');
		for (let m in macs) {
			m = lc(m);
			if (!m) continue;
			res[m] ??= {};
			res[m].reserved_ip = s.ip;
			res[m].dhcp_section = s['.name'];
			res[m].name ??= s.name;
		}
	});
	return res;
}

function reload_wifi() {
	bg('wifi down; sleep 1; wifi up');
}

// --------------------------------------------------------------- Wi-Fi

function wifi_state(u) {
	let radio = radio_name(u);
	if (!radio) return { present: false };
	let r = u.get_all('wireless', radio) ?? {};
	let m = u.get_all('wireless', 'main') ?? {};
	let g = u.get_all('wireless', 'guest_sta');
	let w = u.get_all('wireless', 'wwan');
	return {
		present: true,
		radio, band: r.band ?? '5g', channel: r.channel ?? 'auto', htmode: r.htmode ?? 'HE80',
		country: r.country ?? 'AR', txpower: r.txpower ?? '', radio_disabled: r.disabled == '1',
		enabled: m.disabled != '1', ssid: m.ssid, key: m.key, hidden: m.hidden == '1',
		security: u.get('myownrouter', 'wifi', 'security') ?? 'sae-mixed',
		effective_encryption: m.encryption,
		isolate: m.isolate == '1',
		guest_enabled: g != null && g.disabled != '1',
		guest_key: g?.key ?? u.get('myownrouter', 'wifi', 'guest_key') ?? '',
		repeater: w ? { enabled: w.disabled != '1', ssid: w.ssid, encryption: w.encryption, bssid: w.bssid } : null,
		ifname: ap_ifname(),
	};
}

function wifi_apply_security(u) {
	// MT7921 = single AP; guest uses PPSK, which only works reliably with WPA2.
	let sec = u.get('myownrouter', 'wifi', 'security') ?? 'sae-mixed';
	let guest = u.get('wireless', 'guest_sta') != null;
	let enc = sec;
	if (guest && (sec == 'sae' || sec == 'sae-mixed')) enc = 'psk2';
	if (sec == 'none') enc = 'none';
	u.set('wireless', 'main', 'encryption', enc);
	let key = u.get('wireless', 'main', 'key');
	if (enc != 'none' && key) {
		u.set('wireless', 'main_sta', 'wifi-station');
		u.set('wireless', 'main_sta', 'iface', 'main');
		u.set('wireless', 'main_sta', 'key', key);
	} else {
		u.delete('wireless', 'main_sta');
	}
}

function wifi_set(u, a) {
	let radio = radio_name(u);
	if (!radio) return fail('No hay radio WiFi');
	if (a.ssid != null) {
		if (length(a.ssid) < 1 || length(a.ssid) > 32) return fail('SSID inválido');
		u.set('wireless', 'main', 'ssid', a.ssid);
	}
	if (a.key != null) {
		if (length(a.key) < 8 || length(a.key) > 63) return fail('La contraseña WiFi debe tener entre 8 y 63 caracteres');
		u.set('wireless', 'main', 'key', a.key);
	}
	if (a.security != null) {
		if (!(a.security in ['sae-mixed', 'sae', 'psk2', 'psk-mixed', 'none'])) return fail('Seguridad inválida');
		u.set('myownrouter', 'wifi', 'settings');
		u.set('myownrouter', 'wifi', 'security', a.security);
	}
	if (a.enabled != null) u.set('wireless', 'main', 'disabled', a.enabled ? '0' : '1');
	if (a.hidden != null) u.set('wireless', 'main', 'hidden', a.hidden ? '1' : '0');
	if (a.isolate != null) u.set('wireless', 'main', 'isolate', a.isolate ? '1' : '0');
	if (a.band != null) {
		if (!(a.band in ['2g', '5g'])) return fail('Banda inválida');
		u.set('wireless', radio, 'band', a.band);
		if (a.htmode == null)
			u.set('wireless', radio, 'htmode', a.band == '2g' ? 'HE20' : 'HE80');
	}
	if (a.htmode != null) {
		if (!(a.htmode in ['HE20', 'HE40', 'HE80', 'HE160', 'VHT20', 'VHT40', 'VHT80', 'HT20', 'HT40'])) return fail('Ancho inválido');
		u.set('wireless', radio, 'htmode', a.htmode);
	}
	if (a.channel != null) {
		if (a.channel != 'auto' && !match(`${a.channel}`, /^[0-9]{1,3}$/)) return fail('Canal inválido');
		u.set('wireless', radio, 'channel', `${a.channel}`);
	}
	if (a.txpower != null) {
		if (a.txpower == '' ) u.delete('wireless', radio, 'txpower');
		else if (match(`${a.txpower}`, /^[0-9]{1,2}$/)) u.set('wireless', radio, 'txpower', `${a.txpower}`);
	}
	if (a.country != null && match(a.country, /^[A-Z]{2}$/)) u.set('wireless', radio, 'country', a.country);

	if (a.guest_key != null && a.guest_key != '') {
		if (length(a.guest_key) < 8 || length(a.guest_key) > 63) return fail('La contraseña de invitados debe tener entre 8 y 63 caracteres');
		u.set('myownrouter', 'wifi', 'settings');
		u.set('myownrouter', 'wifi', 'guest_key', a.guest_key);
	}
	if (a.guest_enabled != null) {
		if (a.guest_enabled) {
			let gk = a.guest_key || u.get('myownrouter', 'wifi', 'guest_key');
			if (!gk) return fail('Falta la contraseña de invitados');
			if (gk == u.get('wireless', 'main', 'key')) return fail('La contraseña de invitados debe ser distinta de la principal');
			u.set('wireless', 'guest_vlan', 'wifi-vlan');
			u.set('wireless', 'guest_vlan', 'iface', 'main');
			u.set('wireless', 'guest_vlan', 'name', 'guest');
			u.set('wireless', 'guest_vlan', 'vid', '100');
			u.set('wireless', 'guest_vlan', 'network', 'guest');
			u.set('wireless', 'guest_sta', 'wifi-station');
			u.set('wireless', 'guest_sta', 'iface', 'main');
			u.set('wireless', 'guest_sta', 'key', gk);
			u.set('wireless', 'guest_sta', 'vid', '100');
		} else {
			u.delete('wireless', 'guest_vlan');
			u.delete('wireless', 'guest_sta');
		}
	} else if (a.guest_key && u.get('wireless', 'guest_sta')) {
		u.set('wireless', 'guest_sta', 'key', a.guest_key);
	}
	wifi_apply_security(u);
	u.save('myownrouter'); u.commit('myownrouter');
	u.save('wireless'); u.commit('wireless');
	reload_wifi();
	return ok();
}

// --------------------------------------------------------------- VPN helpers

function vpn_list(u) {
	let res = [];
	u.foreach('network', 'interface', s => {
		if (s.proto == 'wireguard' && match(s['.name'], /^wgc_/)) {
			let st = iface_status(s['.name']);
			let ep = null;
			u.foreach('network', `wireguard_${s['.name']}`, p => { ep ??= p.endpoint_host; });
			push(res, { id: s['.name'], type: 'wireguard', name: u.get('myownrouter', s['.name'], 'label') ?? substr(s['.name'], 4),
				enabled: s.disabled != '1', up: st?.up ?? false, endpoint: ep });
		}
	});
	u.foreach('openvpn', 'openvpn', s => {
		if (!match(s['.name'], /^ovc_/)) return;
		let pid = trim(sh(`pgrep -f ${q('openvpn.*' + s['.name'])} | head -1`));
		let up = access(`/sys/class/net/tun_${substr(s['.name'], 4)}`) != null;
		push(res, { id: s['.name'], type: 'openvpn', name: u.get('myownrouter', s['.name'], 'label') ?? substr(s['.name'], 4),
			enabled: s.enabled == '1', up: up, running: pid != '' });
	});
	return res;
}

function ensure_vpn_zone(u) {
	if (u.get('firewall', 'mor_vpn') == null) {
		u.set('firewall', 'mor_vpn', 'zone');
		u.set('firewall', 'mor_vpn', 'name', 'vpn');
		u.set('firewall', 'mor_vpn', 'input', 'REJECT');
		u.set('firewall', 'mor_vpn', 'output', 'ACCEPT');
		u.set('firewall', 'mor_vpn', 'forward', 'REJECT');
		u.set('firewall', 'mor_vpn', 'masq', '1');
		u.set('firewall', 'mor_vpn', 'mtu_fix', '1');
		u.set('firewall', 'mor_vpn_fwd', 'forwarding');
		u.set('firewall', 'mor_vpn_fwd', 'src', 'lan');
		u.set('firewall', 'mor_vpn_fwd', 'dest', 'vpn');
	}
}

function zone_set_members(u, zone_section, key, members) {
	if (length(members)) u.set('firewall', zone_section, key, members);
	else u.delete('firewall', zone_section, key);
}

function vpn_zone_refresh(u) {
	ensure_vpn_zone(u);
	let nets = [], devs = [];
	u.foreach('network', 'interface', s => { if (s.proto == 'wireguard' && match(s['.name'], /^wgc_/)) push(nets, s['.name']); });
	u.foreach('openvpn', 'openvpn', s => { if (match(s['.name'], /^ovc_/)) push(devs, `tun_${substr(s['.name'], 4)}`); });
	zone_set_members(u, 'mor_vpn', 'network', nets);
	zone_set_members(u, 'mor_vpn', 'device', devs);
}

function parse_wg_conf(text) {
	let sec = null, iface = {}, peers = [], cur = null;
	for (let raw in split(text, '\n')) {
		let l = trim(replace(raw, /[#;].*$/, ''));
		if (!l) continue;
		let h = match(l, /^\[(\w+)\]$/);
		if (h) {
			sec = lc(h[1]);
			if (sec == 'peer') { cur = {}; push(peers, cur); }
			continue;
		}
		let kv = match(l, /^([A-Za-z]+)\s*=\s*(.*)$/);
		if (!kv) continue;
		let k = lc(kv[1]), v = trim(kv[2]);
		if (sec == 'interface') iface[k] = v;
		else if (sec == 'peer' && cur) cur[k] = v;
	}
	if (!iface.privatekey || !length(peers)) return null;
	return { iface, peers };
}

function csv(v) {
	return filter(map(split(v ?? '', ','), trim), x => x != '');
}

// --------------------------------------------------------------- WireGuard server

function wgs_keys(u) {
	let priv = u.get('network', 'wgserver', 'private_key');
	if (!priv) {
		priv = trim(sh('wg genkey'));
	}
	let pub = trim(sh(`echo ${q(priv)} | wg pubkey`));
	return { priv, pub };
}

function wan_public_host(u) {
	let ddns = u.get('myownrouter', 'wgserver', 'endpoint');
	if (ddns) return ddns;
	let w = iface_status('wan');
	return w?.ipaddr ?? '';
}

function wgs_peer_conf(u, name) {
	let p = u.get_all('network', `wgsp_${name}`);
	if (!p) return null;
	let srvpub = trim(sh(`echo ${q(u.get('network', 'wgserver', 'private_key'))} | wg pubkey`));
	let port = u.get('network', 'wgserver', 'listen_port') ?? '51820';
	let lan = u.get('network', 'lan', 'ipaddr') ?? '192.168.20.1';
	let ip = type(p.allowed_ips) == 'array' ? p.allowed_ips[0] : p.allowed_ips;
	let full = u.get('myownrouter', 'wgserver', 'full_tunnel') != '0';
	let lanprefix = replace(lan, /\.[0-9]+$/, '.0/24');
	let srvnet = replace(u.get('network', 'wgserver', 'addresses')?.[0] ?? '10.8.0.1/24', /\.[0-9]+\/.*$/, '.0/24');
	return sprintf("[Interface]\nPrivateKey = %s\nAddress = %s\nDNS = %s\n\n[Peer]\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = %s\nEndpoint = %s:%s\nPersistentKeepalive = 25\n",
		u.get('myownrouter', `wgsp_${name}`, 'private_key') ?? '', ip, lan,
		srvpub, p.preshared_key ?? '', full ? '0.0.0.0/0, ::/0' : `${lanprefix}, ${srvnet}`,
		wan_public_host(u), port);
}

// --------------------------------------------------------------- AdGuard Home

const AGH_YAML = '/etc/adguardhome/adguardhome.yaml';

function agh_write_config(lanip) {
	if (access(AGH_YAML)) return;
	mkdir('/etc/adguardhome');
	writefile(AGH_YAML, sprintf(`http:
  address: %s:3000
  session_ttl: 720h
users: []
auth_attempts: 5
block_auth_min: 15
language: es
theme: auto
dns:
  bind_hosts:
    - 127.0.0.1
  port: 3053
  upstream_dns:
    - https://dns.quad9.net/dns-query
    - https://cloudflare-dns.com/dns-query
  bootstrap_dns:
    - 9.9.9.9
    - 1.1.1.1
  upstream_mode: load_balance
  cache_size: 4194304
  enable_dnssec: true
  ratelimit: 0
filtering:
  protection_enabled: true
  filtering_enabled: true
  safe_search:
    enabled: false
